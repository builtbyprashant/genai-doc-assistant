# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env holds secrets and is never committed — only this example is.

# ── LLM ──────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is read from your SYSTEM (shell) environment, not this file.
# Docker Compose substitutes it from your environment; leaving it out of .env keeps
# the secret out of the project. Set it once in your OS env:
#   PowerShell:  setx ANTHROPIC_API_KEY "sk-ant-..."   (new shells; get a key at
#                https://console.anthropic.com)
#   this shell:  $env:ANTHROPIC_API_KEY = "sk-ant-..."
# Model used by Planner, Reasoner, Validator. Default Haiku for faster responses;
# set claude-sonnet-4-6 for maximum answer quality (slower). Fully configurable.
ANTHROPIC_MODEL=claude-haiku-4-5

# Prompt-caching strategy:
#   block  → cache the system prompt as its own block (default; best here — the
#            system prompt repeats across queries, so it's cache-read after the 1st call)
#   prompt → top-level cache_control marks the whole prompt prefix (good for repeated
#            long prefixes / multi-turn; limited reuse for single-turn RAG)
#   off    → no caching
# Cache hits are visible in the logs as the "llm_usage" event (cache_read_input_tokens).
ANTHROPIC_CACHE_MODE=block

# ── Agent mode ───────────────────────────────────────────────────────────────
# Default mode. A per-request "agent_mode" field on POST /query overrides this.
#   custom      → 7-step pipeline, 3 LLM calls, predictable + full trace
#   llama_index → LlamaIndex ReActAgent, variable LLM calls
#   compare     → runs both, side-by-side results for evaluation
AGENT_MODE=custom

# ── Models (local sentence-transformers, no API key, run on CPU) ──────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
# IMPORTANT: must output 384-dimensional vectors to match the ChromaDB index.
# Changing this requires deleting the index and re-uploading all documents.
# Compatible (384-dim): BAAI/bge-small-en-v1.5, intfloat/e5-small-v2, thenlper/gte-small.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Any sentence-transformers CrossEncoder works — it outputs a score, not a vector,
# so there is NO dimension constraint. e.g. cross-encoder/ms-marco-MiniLM-L-12-v2,
# BAAI/bge-reranker-base.

# ── Retrieval ────────────────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.4              # Top chunk must clear this (cosine, 0.0-1.0) or pipeline short-circuits.
TOP_K_RETRIEVAL=10                    # Chunks fetched from ChromaDB before re-ranking.
TOP_K_RERANK=5                        # Chunks passed to the Reasoner after re-ranking (<= TOP_K_RETRIEVAL).

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=200                        # Words per chunk (kept under all-MiniLM-L6-v2's 256-token limit).
CHUNK_OVERLAP=25                      # Overlapping words between chunks.
MIN_CHUNK_CHARS=20                    # Chunks shorter than this (after stripping) are discarded.

# ── Storage ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=/data/chroma      # Where ChromaDB persists its index.
UPLOAD_SIZE_LIMIT_MB=10               # Max size per uploaded file.
MAX_DOCUMENTS=20                      # Max unique documents allowed in the index.

# ── API / logging ────────────────────────────────────────────────────────────
BACKEND_URL=http://backend:8000       # Streamlit → FastAPI. Use http://localhost:8000 for non-Docker dev.
LOG_LEVEL=INFO                        # DEBUG / INFO / WARNING / ERROR

# ── Reliability ──────────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=20                # First-attempt timeout per LLM call. Retry runs at half this (10s).
QUERY_HASH_ALGO=sha256                # Raw queries are never logged — only a hash. (PII-safe.)

# ── Reserved for Phase 2 (present now, unused in Phase 1) ─────────────────────
GROUNDING_THRESHOLD=0.6               # not read by Phase 1 code.
